# embed_file(<input> <output.h> <symbol>)
# Turns a binary file into a `static const unsigned char symbol[]` header.
function(embed_file IN OUT SYM)
  if(EXISTS ${OUT} AND NOT ${IN} IS_NEWER_THAN ${OUT})
    return()
  endif()
  message(STATUS "Embedding ${IN} -> ${OUT}")
  file(READ ${IN} HEX_DATA HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," ARR "${HEX_DATA}")
  file(WRITE ${OUT}
"// Generated by cmake/embed.cmake - do not edit.
#pragma once
#include <cstddef>
static const unsigned char ${SYM}[] = {${ARR}};
static const size_t ${SYM}_len = sizeof(${SYM});
")
endfunction()
